{
  "compilerOptions": {
    "module": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "stripInternal": true,
    "alwaysStrict": true,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*", "scripts/**/*", "*.js", "*.mjs"]
}
