{
  "name": "jinge-router",
  "version": "4.2.0",
  "description": "lightweight router for jinge web framework",
  "keywords": [
    "jinge",
    "mvvm router",
    "router",
    "web router"
  ],
  "homepage": "https://github.com/jingeweb/jinge-router#readme",
  "bugs": {
    "url": "https://github.com/jingeweb/jinge-router/issues"
  },
  "license": "ISC",
  "author": "Yuhang Ge <abeyuhang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingeweb/jinge-router.git"
  },
  "type": "module",
  "main": "dist/jinge-router.prod.js",
  "module": "dist/jinge-router.prod.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/jinge-router.prod.js"
    },
    "./dev": {
      "types": "./types/index.d.ts",
      "default": "./dist/jinge-router.dev.js"
    },
    "./source": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist types && tsc -project tsconfig.types.json && pnpm build-dev && pnpm build-prod",
    "build-dev": "NODE_ENV=development vite build --mode development -c scripts/vite.config.ts",
    "build-prod": "vite build -c scripts/vite.config.ts",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "patch-version": "npm version patch",
    "prepare": "husky",
    "release:patch": "npm version patch",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "node test/e2e/run.mjs",
    "test:prepare": "node test/build.mjs",
    "test:unit": "node test/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jinge": "^4.2.0",
    "jinge-compiler": "^4.2.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "jinge": "^4.2.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt"
    ]
  }
}
